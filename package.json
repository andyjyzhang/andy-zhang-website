{
  "name": "andys-world",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests vite.config.ts",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build && node scripts/build-fallback.mjs",
    "check:build": "node scripts/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "build:parts": "node scripts/build-parts.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/three": "^0.180.0",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^16.4.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "24.x"
  }
}
